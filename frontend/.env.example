# =====================================================================
# Frontend SvelteKit (Vite). Copia este archivo a .env en frontend/
# En Windows: copy .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# Desarrollo (opcional): destino del proxy de Vite.
# El navegador siempre llama a rutas relativas (/api y /api-express);
# el proxy de Vite (vite.config.js) las reenvia a estos destinos.
# ---------------------------------------------------------------------
VITE_API_TARGET=http://localhost:8000
VITE_EXPRESS_TARGET=http://localhost:3000

# ---------------------------------------------------------------------
# Publicacion como sitio estatico: aqui NO hay proxy de Vite, asi que
# hay que indicar la URL publica de cada API. Si se definen, ganan
# sobre el proxy. Si se dejan vacias, el sitio usa /api y /api-express.
# ---------------------------------------------------------------------
# VITE_API_URL=https://tu-api.onrender.com
# VITE_EXPRESS_URL=https://tu-api-express.onrender.com
