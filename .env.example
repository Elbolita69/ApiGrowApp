# =====================================================================
# API principal (FastAPI + PostgreSQL en Neon)
# Copia este archivo a .env en la raiz del proyecto y completa los datos.
# En Windows: copy .env.example .env
# =====================================================================

# Host de PostgreSQL (Neon). Ejemplo: ep-cool-name-a1b2c3.us-east-2.aws.neon.tech
DB_HOST=ep-tu-base.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=growapp
DB_USER=tu_usuario
DB_PASSWORD=tu_password

# true en Neon (TLS), false en una base local de PostgreSQL
DB_SSL=true

# Clave para firmar los JWT. Genera una larga y aleatoria.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Orígenes permitidos para CORS, separados por coma.
# En local: http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =====================================================================
# API auxiliar (Express + MySQL en Railway) - opcional
# El archivo .env va dentro de express-api/
# =====================================================================
# MYSQL_URL=mysql://usuario:contrasena@host:3306/nombre_base
# PORT=3000
